# 数字丝路部署环境变量示例
# 使用：cp .env.example .env，然后只在 .env 中填写真实值。

# ---------- 应用与端口 ----------
APP_NAME=Digital Silk Road API
APP_DEBUG=false
APP_LANGUAGE=zh
SERVER_HOST=0.0.0.0
SERVER_PORT=5678
SERVER_READ_TIMEOUT=600
SERVER_WRITE_TIMEOUT=600
SERVER_CORS_ORIGINS=http://localhost:3012

# ---------- SQLite（默认） ----------
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/drama_generator.db

# ---------- MySQL（启用时填写） ----------
# DATABASE_TYPE=mysql
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=3306
# DATABASE_USER=digital_silk_road
# DATABASE_PASSWORD=change_me
# DATABASE_NAME=digital_silk_road
# DATABASE_CHARSET=utf8mb4

# ---------- 素材与生成结果 ----------
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/storage
# 服务器部署时改为浏览器可访问的地址，例如 https://demo.example.com/static
STORAGE_BASE_URL=http://localhost:5678/static

# Cloudflare R2（可选；本地目录仍作为上传缓存）
# STORAGE_TYPE=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=
# R2_REGION=auto

# ---------- 丝路 Agent / 合规模型 ----------
AGENT_PROVIDER=deepseek
AGENT_BASE_URL=https://api.deepseek.com
AGENT_TEXT_MODEL=deepseek-v4-pro
AGENT_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

COMPLIANCE_ENABLED=true
COMPLIANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
COMPLIANCE_ENDPOINT=/chat/completions
COMPLIANCE_MODEL=deepseek-v3-2-251201
COMPLIANCE_API_KEY=

# 商品图片理解（可选；缺失时降级为文本分析）
AGENT_VISION_PROVIDER=glm
AGENT_VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AGENT_VISION_MODEL=
AGENT_VISION_API_KEY=

# GLM/火山方舟兼容变量（按实际供应商选填）
GLM_API_KEY=
GLM_BASE_URL=
GLM_TEXT_MODEL=
GLM_VISION_MODEL=
ARK_API_KEY=
ARK_BASE_URL=
ARK_MODEL=
ARK_VISION_MODEL=

# ---------- 数字人 / TTS ----------
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=
VOLCENGINE_SPEECH_APP_ID=
VOLCENGINE_SPEECH_TOKEN=
VOLCENGINE_SPEECH_VOICE_TYPE=

# ---------- 图片与视频生成 ----------
# 图片/视频模型的 Base URL、Key、模型和 endpoint 默认在前端“设置 > AI 服务配置”中保存。
# 未配置时接口会返回明确错误，不会生成假成功结果。

# ---------- 分发服务（可选） ----------
DISTRIBUTION_SECRET_KEY=
UPLOAD_POST_API_KEY=
UPLOAD_POST_BASE_URL=https://api.upload-post.com/api
DISTRIBUTION_GATEWAY_URL=
DISTRIBUTION_GATEWAY_TOKEN=
DISTRIBUTION_GATEWAY_TIMEOUT_SECONDS=30

# ---------- 前端与 Docker 构建 ----------
VITE_API_BASE_URL=/api/v1
VITE_DEV_PROXY_TARGET=http://127.0.0.1:5678
# 仅比赛演示使用，生产环境必须留空。
VITE_DEMO_DEVICE_ID=
DOCKER_REGISTRY=
NPM_REGISTRY=
GO_PROXY=https://goproxy.cn,direct
ALPINE_MIRROR=
