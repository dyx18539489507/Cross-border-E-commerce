# 开发环境保持同源代理时使用相对 API 前缀。
VITE_API_BASE_URL=/api/v1

# Vite 开发代理指向后端。后端换端口时只改这里，不改源码。
VITE_DEV_PROXY_TARGET=http://127.0.0.1:5678

# 仅比赛单机演示时设置；生产环境不要设置共享设备 ID。
# VITE_DEMO_DEVICE_ID=demo-device-digital-silk-road

# 前后端分域部署时，VITE_API_BASE_URL 可改为完整地址并重新构建：
# VITE_API_BASE_URL=https://api.example.com/api/v1
